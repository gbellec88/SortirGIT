{% extends 'base.html.twig' %}

{% block body %}
    <h1>Liste des sorties</h1>
    {# todo : afficher les sorties #}
    <table class="table table-dark">
        <thead>
        <tr>
            <th scope="col">Nom de la sortie</th>
            <th scope="col">Date de la sortie</th>
            <th scope="col">Clôture</th>
            <th scope="col">Inscrits/Places</th>
            <th scope="col">Etat</th>
            <th scope="col">Organisateur</th>
            <th scope="col">Actions</th>
        </tr>
        </thead>
        <tbody>

        <form method="get" action="{{ path('sorties_list') }}">
              <div class="row">
                <div class="col-md-6">
                    <label for="campus">Campus :</label>

                    <select name="campus" id="campus" class="form-select">

                        {% for uncampus in campus %}
                            <option value="{{ uncampus.id }}"
                                    {% if selectedCampus == uncampus.id %}
                                selected
                                {% endif %}
                            >

                                {{ uncampus.nom }}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            name="organisateur"
                            id="organisateur"
                            class="form-check-input"
                            value="0"

                        >
                        <label for="organisateur" class="form-check-label">
                            Sorties dont je suis l'organisateur
                        </label>
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            name="inscrit"
                            id="inscrit"
                            class="form-check-input"
                            value="0"

                        >
                        <label for="inscrit" class="form-check-label">
                            Sorties ou je suis inscrit
                        </label>
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            name="pasInscrit"
                            id="pasInscrit"
                            class="form-check-input"
                            value="0"

                        >
                        <label for="pasInscrit" class="form-check-label">
                            Sorties auxquelles je ne suis pas inscrit(e)
                        </label>
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            name="terminees"
                            id="terminees"
                            class="form-check-input"
                            value="0"

                        >
                        <label for="terminees" class="form-check-label">
                            Sorties terminées
                        </label>
                    </div>

                </div>
                {# Filtrage Entre 2 dates  #}
                <div class="col-md-5">
                    <label for="dateDebut">Entre</label>
                    <input
                        type="date"
                        id="dateDebut"
                        name="dateDebut"
                        class="form-control"
                        value="{{ app.request.query.get('dateDebut') }}"
                    >

                    <label for="dateFin">et</label>
                    <input
                        type="date"
                        id="dateFin"
                        name="dateFin"
                        class="form-control"
                        value="{{ app.request.query.get('dateFin') }}"
                    >
                </div>

                <div class="col-md-5">
                    <label for="nomSortie" class="form-label">Le nom de la sortie contient</label>
                    <input
                        type="text"
                        id="nomContient"
                        name="nomContient"
                        class="form-control"
                        placeholder="Nom de la sortie"
                        value="{{ app.request.query.get('nomContient') ?? '' }}"
                    >
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        Rechercher
                    </button>
                </div>
            </div>
        </form>

        {% for sortie in sorties %}


            <tr>
                <td>{{ sortie.nom }}</td>
                <td>{{ sortie.dateHeureDebut | date('d/m/Y') }}</td>
                <td>{{ sortie.dateLimiteInscription | date('d/m/Y') }}</td>
                <td>{{ sortie.nbinscriptionMax }}</td>  {# todo : calculer le nombre d'inscrits les cours #}
                <td>{{ sortie.etat.libelle }}</td>
                <td>{{ sortie.organisateur.nom }} {{ sortie.organisateur.prenom }}</td>

                {# todo :  #}
               <td><a href="{{ path('sortie_detail',{id:sortie.id}) }}" title="voir details sortie">Afficher</a></td>



                {% if app.user===sortie.organisateur %}
                <td><a href="{{ path('sortie_modifier',{id:sortie.id}) }}" title="modifier">Modifier</a></td>
                {% endif %}

                {% if app.user!==sortie.organisateur %}
                    <td><a href="{{ path('sortie_inscrire',{id:sortie.id}) }}" title="s'inscrire">S'inscrire</a></td>
                {% endif %}

                {#{% if app.user===sortie.organisateur %}
                <td><a href="{{ path('sortie_supprimer',{id:sortie.id})}}" title="Supprimer la Sortie">Supprimer</a></td>
                {% endif %}
                  <td><a href="{{ path('sortie_show',{id:course.id}) }}" title="se désister">S'inscrire</a></td>
                <td><a href="{{ path('sortie_show',{id:course.id}) }}" title="se désister">publier</a></td>
                #}


            </tr>
        {% endfor %}
        </tbody>

    </table>
    <div class="mt-3">
        <a href="{{ path('sortie_create') }}" class="btn btn-success">
            Créer une sortie
        </a>
    </div>
{% endblock %}

{% block title %}
    Les sorties | {{ parent() }}
{% endblock %}
