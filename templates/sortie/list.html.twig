{% extends 'base.html.twig' %}

{% block body %}
    <h1>Liste des sorties</h1>
    {# todo : afficher les sorties #}
    <table class="table table-dark">
        <thead>
        <tr>
            <th scope="col">Nom de la sortie</th>
            <th scope="col">Date de la sortie</th>
            <th scope="col">Clôture</th>
            <th scope="col">Inscrits/Places</th>
            <th scope="col">Etat</th>
            <th scope="col">Organisateur</th>
            <th scope="col">Actions</th>
        </tr>
        </thead>
        <tbody>

        <form method="get" action="{{ path('sorties_list') }}">
            <div class="row">
                <div class="col-md-6">
                    <label for="campus">Campus :</label>

                    <select name="campus" id="campus" class="form-select">
                        <option value="">-- Tous les campus --</option>

                        {% for uncampus in campus %}
                            <option value="{{ uncampus.id }}"
                                    {% if app.user.campus and app.user.campus.id == uncampus.id %}
                                selected
                                {% endif %}>
                                {{ uncampus.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        Rechercher
                    </button>
                </div>
            </div>
        </form>

        {% for sortie in sorties %}


            <tr>
                <td>{{ sortie.nom }}</td>
                <td>{{ sortie.dateHeureDebut | date('d/m/Y') }}</td>
                <td>{{ sortie.dateLimiteInscription | date('d/m/Y') }}</td>
                <td>{{ sortie.nbinscriptionMax }}</td>  {# todo : calculer le nombre d'inscrits les cours #}
                <td>{{ sortie.etat.libelle }}</td>
                <td>{{ sortie.organisateur.nom }} {{ sortie.organisateur.prenom }}</td>

                {# todo :  #}
               <td><a href="{{ path('sortie_detail',{id:sortie.id}) }}" title="voir details sortie">Afficher</a></td>
                {#<td><a href="{{ path('sortie_show',{id:course.id}) }}" title="se désister">Se désister</a></td>
                <td><a href="{{ path('sortie_show',{id:course.id}) }}" title="se désister">S'inscrire</a></td>
                <td><a href="{{ path('sortie_show',{id:course.id}) }}" title="se désister">publier</a></td>
                <td><a href="{{ path('sortie_show',{id:course.id}) }}" title="se désister">Supprimer</a></td>#}


            </tr>
        {% endfor %}
        </tbody>

    </table>
{% endblock %}

{% block title %}
    Les sorties | {{ parent() }}
{% endblock %}
